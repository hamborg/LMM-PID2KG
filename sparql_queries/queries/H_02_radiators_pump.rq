PREFIX ex: <http://example.org/mybuilding/> 
PREFIX bot: <https://w3id.org/bot#>
PREFIX brick: <https://brickschema.org/schema/Brick#> 
PREFIX fso: <https://w3id.org/fso#> 
PREFIX fpo: <http://example.com/fpo#> 
PREFIX sosa: <http://www.w3.org/ns/sosa/> 
PREFIX qudt: <http://qudt.org/schema/qudt/> 
PREFIX unit: <http://qudt.org/vocab/unit/> 
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 

# How many radiators are fed by a pump or a mixing circuit?
SELECT DISTINCT ?pump ?sourceType ?radiator 
WHERE {
    ?radiator rdf:type brick:Radiator .
    ?pump rdf:type ?sourceType .

    ?pump (brick:feeds | fso:feedsFluidTo)+ ?radiator .

    VALUES ?sourceType {
            brick:Pump
            brick:Mixing_circuit
            brick:Water_Loop
            brick:Equipment
            
            brick:Water_System
            brick:Heating_System
            brick:Hot_Water_Return_System
            brick:Hot_Water_Supply_System
    }
}