PREFIX ex: <http://example.org/mybuilding/> 
PREFIX bot: <https://w3id.org/bot#>
PREFIX brick: <https://brickschema.org/schema/Brick#> 
PREFIX fso: <https://w3id.org/fso#> 
PREFIX fpo: <http://example.com/fpo#> 
PREFIX sosa: <http://www.w3.org/ns/sosa/> 
PREFIX qudt: <http://qudt.org/schema/qudt/> 
PREFIX unit: <http://qudt.org/vocab/unit/> 
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 

# How many fans are connected to a heat exchanger (either upstream or downstream)?
SELECT DISTINCT ?fan ?fanType ?relation ?hx
WHERE {
    ?fan rdf:type ?fanType .
    ?hx rdf:type ?hxType .

    VALUES ?hxType {
        brick:Heat_Exchanger
        brick:Counter_Heat_Exchanger
        brick:Plate_Heat_Exchanger
        brick:Rotary_Heat_Exchanger
    }

    VALUES ?fanType {
        brick:AHU
        brick:Air_Handling_Unit
        brick:Fan
        brick:Supply_Fan 
        brick:Return_Fan
        brick:Exhaust_Fan
    }

    # Relations
    {
        ?hx (fso:feedsFluidTo | ^fso:feedsFluidTo)+ ?fan .
        BIND("HX ←→ Fan" AS ?relation)
    }
    UNION
    {
        ?ahu brick:hasPart ?hx, ?fan .
        BIND("AHU has (HX, Fan)" AS ?relation)
    }

}