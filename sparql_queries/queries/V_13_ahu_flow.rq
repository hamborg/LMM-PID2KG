PREFIX ex: <http://example.org/mybuilding/> 
PREFIX bot: <https://w3id.org/bot#>
PREFIX brick: <https://brickschema.org/schema/Brick#> 
PREFIX fso: <https://w3id.org/fso#> 
PREFIX fpo: <http://example.com/fpo#> 
PREFIX sosa: <http://www.w3.org/ns/sosa/> 
PREFIX qudt: <http://qudt.org/schema/qudt/> 
PREFIX unit: <http://qudt.org/vocab/unit/> 
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 

# How many air handling units have a design airflow?
SELECT DISTINCT ?ahu ?relation ?propertyType ?value
WHERE {
    ?ahu rdf:type ?ahuType .
    VALUES ?ahuType {
        brick:AHU
        brick:Air_Handling_Unit
    } .

    ?property rdf:type fpo:DesignAirFlow ;
        fpo:hasValue ?value .
    
    # Relations
    {
        ?ahu fpo:hasProperty ?property .
        BIND("AHU property" AS ?relation)
    }
    UNION
    {
        VALUES ?fanType {
            brick:Fan
            brick:Supply_Fan 
            brick:Return_Fan 
            brick:Exhaust_Fan_Fan 
        }

        ?ahu brick:hasPart ?fan .
        ?fan rdf:Type ?fanType ;
            fpo:hasProperty ?property .

        BIND("Fan (in AHU) property" AS ?relation)
    }
}